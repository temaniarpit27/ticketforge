# Use a separate Jira service account so its comments cannot be mistaken for yours.
JIRA_EMAIL=bot@your-company.example
JIRA_API_TOKEN=
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
# Only needed when coder_provider or reviewer_provider is "openai".
OPENAI_API_KEY=
# Custom providers read their key from the variable named by their api_key_env.
# Optional; otherwise TicketForge uses your configured Git identity.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
